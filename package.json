{
  "name": "kawacity",
  "version": "2.0.0",
  "description": "KawaCity, a city simulator based on micropolisJS, a port of the open-source simulator \"Micropolis\" to Javascript/HTML5",
  "repository": {
    "type": "git",
    "url": "https://github.com/kawakode/micropolisJS-docker.git"
  },
  "bugs": {
    "url": "https://github.com/kawakode/micropolisJS-docker/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "webpack --mode production",
    "watch": "webpack --watch --mode development --config-name client",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "tsc --noEmit --skipLibCheck -p . && tsc --noEmit --skipLibCheck -p server",
    "dev": "webpack serve --mode development --config-name client",
    "production": "webpack serve --mode production --config-name client",
    "dev:server": "webpack --watch --mode development --config-name server",
    "start:server": "UV_THREADPOOL_SIZE=8 node --env-file-if-exists=.env --disable-warning=ExperimentalWarning --enable-source-maps --watch build/server/main.cjs",
    "start": "UV_THREADPOOL_SIZE=8 node --disable-warning=ExperimentalWarning --enable-source-maps build/server/main.cjs"
  },
  "devDependencies": {
    "@types/jest": "30.0.0",
    "@types/node": "22.20.5",
    "@types/nodemailer": "8.0.2",
    "@types/ws": "8.18.2",
    "clean-webpack-plugin": "4.0.0",
    "copy-webpack-plugin": "13.0.0",
    "git-revision-webpack-plugin": "5.0.0",
    "html-webpack-plugin": "5.6.3",
    "jest": "30.0.4",
    "jquery": "3.7.1",
    "ts-jest": "29.4.0",
    "ts-loader": "9.5.2",
    "typescript": "5.8.3",
    "webpack": "5.100.1",
    "webpack-cli": "6.0.1",
    "webpack-dev-server": "5.2.2"
  },
  "author": "Graeme McCutcheon (http://www.graememcc.co.uk)",
  "contributors": [
    "kawakode (https://github.com/kawakode)"
  ],
  "license": "GPL-3.0",
  "readmeFilename": "README.md",
  "dependencies": {
    "nodemailer": "10.1.3",
    "ws": "8.22.0"
  }
}
